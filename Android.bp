soong_namespace {
    imports: [
        "hardware/nothing",
    ],
}

// Camera Client Shim
cc_library_shared {
    name: "libcamera_client_shim",
    srcs: [
        "shim/camera_client_shim.cpp",
        "offlineproc/IOfflineProcService.cpp",
    ],
    shared_libs: [
        "libutils",
        "liblog",
        "libbinder",
    ],
    system_ext_specific: true,
}

// Subdirectories
subdirs = [
    "nothing-fwk",
    "offlineproc",
]

// Prebuilt Libraries & Binaries

cc_prebuilt_library_shared {
    name: "libarcsoft_hdr_detection",
    owner: "nothing",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: [
                "proprietary/vendor/lib64/libarcsoft_hdr_detection.so",
            ],
            shared_libs: [
                "liblog",
                "libutils",
                "libcutils",
            ],

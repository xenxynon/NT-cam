cc_binary {
    name: "android.hardware.offline_proc@1.0-service.nothing",
    relative_install_path: "hw",
    defaults: ["hidl_defaults"],
    vendor: true,
    init_rc: ["android.hardware.offline_proc@1.0-service.nothing.rc"],

    srcs: [
        "IOfflineProcService.cpp",
        "OfflineProcService.cpp",
    ],

    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libbinder",
    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],
}
